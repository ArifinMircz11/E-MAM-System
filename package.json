    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rimraf dist .cache",
    "migrate": "tsx src/migration/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npx @biomejs/biome check src server.ts && oxlint src server.ts && eslint src server.ts",
    "analyze": "npm run typecheck && npm run lint && npm run depcruise && npm run knip",
    "depcruise": "depcruise src --config .dependency-cruiser.js --ignore-known .dependency-cruiser-known-violations.json",
    "semgrep": "semgrep scan --config=semgrep.yml",
    "knip": "knip",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "npm run analyze && npm run build && npm run test:e2e",
    "audit": "tsx scripts/audit/index.ts",
    "audit:quick": "tsx scripts/audit/index.ts",
    "audit:full": "node scripts/audit/full.js",
    "audit:report": "node scripts/audit/report.js",
    "audit:firestore": "tsx scripts/audit/firestore-boundary-strict.ts",
    "audit:production": "tsx scripts/audit/production-gate.ts",
    "audit:repository": "node scripts/audit/repository.js",
    "audit:tenant": "node scripts/audit/tenant.js",
    "audit:sync": "node scripts/audit/schema/firestore-dexie-sync.js",
    "audit:rbac": "node scripts/audit/schema/rbac-audit.js",
    "audit:architecture": "node scripts/audit/architecture.js",
    "audit:index": "node scripts/audit/index-check.js",
    "audit:dexie": "node scripts/audit/dexie.js",
    "audit:offline": "node scripts/audit/offline.js",
    "audit:hooks": "node scripts/audit/hooks.js",
    "audit:services": "node scripts/audit/services.js",
    "audit:components": "node scripts/audit/components.js",
    "audit:schema": "node scripts/audit/schema/blueprint-validator.js",
    "audit:users": "node scripts/audit/schema/users-audit.js",
    "audit:contracts": "node scripts/audit/contracts.js",
    "audit:security": "node scripts/audit/security.js",
    "audit:performance": "node scripts/audit/performance.js",
    "audit:feature": "node scripts/audit/feature.js",
    "audit:module": "node scripts/audit/module.js",
    "audit:workspace": "node scripts/audit/workspace.js",
    "audit:sync-coverage": "node scripts/audit/sync-coverage.js",
    "audit:build": "node scripts/audit/build.js",
    "audit:tests": "node scripts/audit/tests.js",
    "audit:deadcode": "node scripts/audit/deadcode.js",
    "audit:typescript": "node scripts/audit/typescript.js",
    "verify": "npm run typecheck && npm run lint && npm run audit && npm run audit:production && npm run build && npm run test:unit",
    "test:all": "npm run audit && vitest run",
    "emam": "tsx emam/index.ts",
    "progress": "node scripts/progress-recorder.js",
    "doctor": "node scripts/audit/doctor.js",
    "fix": "tsx scripts/fix/index.ts",
    "fix:structure": "tsx scripts/fix/structure.ts",
    "fix:imports": "tsx scripts/fix/imports.ts",
    "prepare": "husky"
  }
}
