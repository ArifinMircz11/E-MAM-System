rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Developer authority is UID-backed only. Email is never an authorization source.
    function isDeveloper() {
      return hasUserDoc() && (
        currentUser().get('role', '') == 'developer' ||
        'developer' in currentUser().get('roles', [])
      ) && currentUser().get('tenantId', '') != '';
    }

    function hasRole(role) {
      return hasUserDoc() && (
        currentUser().get('role', '') == role ||
        role in currentUser().get('roles', [])
      );
    }

    function hasAnyRole(roles) {
      return hasUserDoc() && (
        currentUser().get('role', '') in roles ||
        currentUser().get('roles', []).hasAny(roles)
      );
    }

    function isAdmin() {
      return hasAnyRole(['admin', 'developer']);
    }

    function canonicalTenant() {
      return currentUser().get('tenantId', '');
    }

    function hasCanonicalTenant() {
      return hasUserDoc() && canonicalTenant() != '' &&
        canonicalTenant() != 'default' &&
        canonicalTenant() != 'unknown' &&
        canonicalTenant() != 'global';
    }

    // Authenticated is not authorized. Every tenant-scoped operation requires
    // an existing canonical user and a concrete tenant.
    function isValidTenant(tenantId) {
      return hasCanonicalTenant() && tenantId != '' && tenantId == canonicalTenant();
    }

    function resourceTenantId() {
      return resource.data.get('tenantId', resource.data.get('schoolId', ''));
    }

    function requestTenantId() {
      return request.resource.data.get('tenantId', request.resource.data.get('schoolId', ''));
    }

    function isTenantMatch() {
      return hasCanonicalTenant() && resource != null && isValidTenant(resourceTenantId());
    }

    function isNewDocTenantMatch() {
      return hasCanonicalTenant() && request.resource != null && isValidTenant(requestTenantId());
    }

    function isManajemen() {
      return hasAnyRole(['kepala_madrasah', 'kepala_tu', 'wakamad', 'kesiswaan', 'kurikulum']) || isAdmin();
    }

    // --- PUBLIC / NON-TENANT READ-ONLY ---
    match /system_config/app_version { allow read: if true; }
    match /system_config/master_version { allow read: if true; }
    match /system_config/maintenance { allow read: if true; }
    match /system_settings/maintenance_config { allow read: if true; }
    match /news/{id} { allow read: if true; allow write: if isDeveloper() || isAdmin() || isManajemen(); }
    match /ticker/{id} { allow read: if true; allow write: if isDeveloper() || isAdmin() || isManajemen(); }
    match /events/{id} { allow read: if true; allow write: if isDeveloper() || (isNewDocTenantMatch() && isManajemen()); }

    // --- SYSTEM ---
    match /system/role_permissions { allow read: if hasCanonicalTenant(); }
    match /system/feature_locks { allow read: if hasCanonicalTenant(); }
    match /system_config/feature_locks { allow read: if hasCanonicalTenant(); }
    match /documentation/{id} { allow read: if hasCanonicalTenant(); allow write: if isDeveloper() || isAdmin(); }
    match /system_config/{docId} { allow read, write: if isDeveloper(); }
    match /system_configs/{path=**} { allow read, write: if isDeveloper(); }

    // --- TENANT / MASTER DATA ---
    match /tenants/{tenantId} {
      allow read: if isValidTenant(tenantId) || (isDeveloper() && tenantId == canonicalTenant());
      allow write: if isDeveloper() || isAdmin();
    }

    match /subjects/{id} {
      allow read: if isTenantMatch();
      allow write: if isDeveloper() || isAdmin() || (isNewDocTenantMatch() && isManajemen());
    }

    match /classes/{id} {
      allow read: if isTenantMatch();
      allow write: if isDeveloper() || isAdmin() || (isNewDocTenantMatch() && isManajemen());
    }

    match /schedules/{id} {
      allow read: if isTenantMatch();
      allow write: if isDeveloper() || isAdmin() || (isNewDocTenantMatch() && (isManajemen() || hasAnyRole(['guru', 'kurikulum'])));
    }

    match /teachers/{teacherId} {
      allow read: if isTenantMatch();
      allow create: if isDeveloper() || isAdmin() || isNewDocTenantMatch();
      allow update: if isDeveloper() || isAdmin() || (
        isTenantMatch() && isNewDocTenantMatch() &&
        request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '') &&
        request.resource.data.get('idUnik', '') == resource.data.get('idUnik', '')
      );
      allow delete: if isDeveloper() || isAdmin();
    }

    match /academic_years/{id} {
      allow read: if isTenantMatch();
      allow write: if isDeveloper() || isAdmin() || (isNewDocTenantMatch() && isManajemen());
    }

    match /point_categories/{id} {
      allow read: if isTenantMatch();
      allow write: if isDeveloper() || isAdmin() || (isNewDocTenantMatch() && isManajemen());
    }

    match /students/{studentId} {
      allow read: if isTenantMatch();
      allow create: if isDeveloper() || isAdmin() || isNewDocTenantMatch();
      allow update: if isDeveloper() || isAdmin() || (
        isTenantMatch() && isNewDocTenantMatch() &&
        request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '') &&
        request.resource.data.get('idUnik', '') == resource.data.get('idUnik', '') &&
        request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
      );
      allow delete: if isDeveloper() || isAdmin();
    }

    match /studentParents/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }
    match /summaries/{id} { allow read: if isTenantMatch(); }
    match /daily_stats/{id} { allow read: if isTenantMatch(); }

    // --- TRANSACTIONAL ---
    match /attendance/{id} {
      allow read: if isTenantMatch() && (
        isDeveloper() || isManajemen() ||
        resource.data.get('studentsId', resource.data.get('studentId', '')) == currentUser().get('referenceId', '') ||
        hasAnyRole(['guru', 'wali_kelas', 'staf', 'guru_bk'])
      );
      allow create: if isDeveloper() || (isNewDocTenantMatch() && request.resource.data.version == 1);
      allow update: if isDeveloper() || (isTenantMatch() && isNewDocTenantMatch() && request.resource.data.tenantId == resource.data.tenantId && request.resource.data.version > resource.data.version);
      allow delete: if false;
    }

    match /points/{id} {
      allow read: if isTenantMatch() && (isDeveloper() || isManajemen() || resource.data.get('studentsId', resource.data.get('studentId', '')) == currentUser().get('referenceId', '') || hasAnyRole(['guru', 'wali_kelas', 'staf', 'guru_bk']));
      allow create: if isDeveloper() || (isNewDocTenantMatch() && (isManajemen() || hasAnyRole(['guru', 'wali_kelas', 'staf', 'guru_bk'])) && request.resource.data.version == 1);
      allow update: if isDeveloper() || (isTenantMatch() && isNewDocTenantMatch() && (isManajemen() || hasAnyRole(['guru', 'wali_kelas', 'staf', 'guru_bk'])) && request.resource.data.tenantId == resource.data.tenantId && request.resource.data.version > resource.data.version);
      allow delete: if isDeveloper() || (isTenantMatch() && isManajemen());
    }

    match /grades/{id} {
      allow read: if isTenantMatch() && (isDeveloper() || isManajemen() || resource.data.get('studentsId', resource.data.get('studentId', '')) == currentUser().get('referenceId', '') || hasAnyRole(['guru', 'wali_kelas', 'staf', 'guru_bk']));
      allow write: if isDeveloper() || (isNewDocTenantMatch() && (isManajemen() || hasAnyRole(['guru', 'wali_kelas', 'staf', 'guru_bk'])));
    }

    match /letters/{id} {
      allow read: if isTenantMatch() && (resource.data.userId == request.auth.uid || isManajemen() || isDeveloper());
      allow create: if isDeveloper() || (isNewDocTenantMatch() && request.resource.data.version == 1);
      allow update: if isDeveloper() || (isTenantMatch() && isNewDocTenantMatch() && (resource.data.userId == request.auth.uid || isManajemen()) && request.resource.data.tenantId == resource.data.tenantId && request.resource.data.version > resource.data.version);
      allow delete: if isDeveloper() || (isTenantMatch() && isManajemen());
    }

    match /notifications/{id} {
      allow read: if isTenantMatch() && (resource.data.userId == request.auth.uid || isManajemen() || resource.data.get('targetRole', '') != '');
      allow write: if isDeveloper() || isNewDocTenantMatch();
    }

    match /profile_update_requests/{id} {
      allow read, update: if isTenantMatch() && (resource.data.get('userId', '') == request.auth.uid || isManajemen() || isDeveloper());
      allow create: if isDeveloper() || (isNewDocTenantMatch() && request.resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isDeveloper();
    }

    match /approval_requests/{id} {
      allow read, update: if isTenantMatch() && (resource.data.get('userId', '') == request.auth.uid || isManajemen() || isDeveloper());
      allow create: if isDeveloper() || (isNewDocTenantMatch() && request.resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isDeveloper();
    }

    match /teacher_attendance/{id} {
      allow read: if isTenantMatch() && (isDeveloper() || isManajemen() || resource.data.get('teachersId', '') == currentUser().get('referenceId', ''));
      allow write: if isDeveloper() || (isNewDocTenantMatch() && (isManajemen() || hasAnyRole(['guru', 'staf'])));
    }

    match /journals/{id} {
      allow read: if isTenantMatch() && (isDeveloper() || isManajemen() || hasAnyRole(['guru', 'wali_kelas']));
      allow create: if isDeveloper() || (isNewDocTenantMatch() && hasAnyRole(['guru', 'wali_kelas']) && request.resource.data.version == 1);
      allow update: if isDeveloper() || (isTenantMatch() && isNewDocTenantMatch() && hasAnyRole(['guru', 'wali_kelas']) && request.resource.data.tenantId == resource.data.tenantId && request.resource.data.version > resource.data.version);
      allow delete: if isDeveloper() || (isTenantMatch() && hasAnyRole(['guru', 'wali_kelas']));
    }

    match /assignments/{id} { allow read: if isTenantMatch(); allow write: if isDeveloper() || (isNewDocTenantMatch() && hasAnyRole(['guru', 'wali_kelas'])); }

    match /submissions/{id} {
      allow read: if isTenantMatch() && (isDeveloper() || isManajemen() || resource.data.get('studentId', '') == currentUser().get('referenceId', '') || hasAnyRole(['guru', 'wali_kelas']));
      allow write: if isDeveloper() || (isNewDocTenantMatch() && (hasAnyRole(['guru', 'wali_kelas']) || request.resource.data.get('studentId', '') == currentUser().get('referenceId', '')));
    }

    match /chat_rooms/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }
    match /chat_messages/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }
    match /academic_configs/{id} { allow read: if isTenantMatch(); allow write: if isDeveloper() || (isNewDocTenantMatch() && isManajemen()); }
    match /qr_sessions/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }
    match /activity_logs/{id} { allow read, create: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); allow update, delete: if isDeveloper(); }
    match /backups/{id} { allow read, write: if isDeveloper() || (isTenantMatch() && isManajemen()); }

    // Client-side sync metadata is tenant-bound. It is not an authorization bypass.
    match /sync_queue/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch(); }
    match /sync_metadata/{deviceId} { allow read, write: if isTenantMatch() || isNewDocTenantMatch(); }
    match /deleted_records/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch(); }
    match /sync_conflicts/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch(); }
    match /devices/{deviceId} { allow read, write: if isTenantMatch() || isNewDocTenantMatch(); }

    match /summary/{id} { allow read: if isTenantMatch(); allow write: if isDeveloper() || (isNewDocTenantMatch() && isManajemen()); }
    match /student_point_summaries/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }
    match /complaints/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }
    match /conversations/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }
    match /messages/{id} { allow read, write: if isTenantMatch() || isNewDocTenantMatch() || isDeveloper(); }

    // --- USER / SECURITY DATA ---
    match /users/{userId} {
      allow read: if hasCanonicalTenant() && (request.auth.uid == userId || isManajemen() || isDeveloper());
      allow create: if isDeveloper() || (hasCanonicalTenant() && request.auth.uid == userId && isNewDocTenantMatch());
      allow update: if isDeveloper() || (
        hasCanonicalTenant() && request.auth.uid == userId && isTenantMatch() && isNewDocTenantMatch() &&
        request.resource.data.get('role', '') == resource.data.get('role', '') &&
        request.resource.data.get('roles', []) == resource.data.get('roles', []) &&
        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
        request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
      );
      allow delete: if isDeveloper();
    }

    match /audit_logs/{path=**} {
      allow read: if isDeveloper();
      allow create: if hasCanonicalTenant() && isNewDocTenantMatch();
      allow update, delete: if false;
    }

    match /login_logs/{id} {
      allow read: if isDeveloper() || (isTenantMatch() && request.auth.uid == resource.data.userId);
      allow create: if hasCanonicalTenant() && isNewDocTenantMatch();
      allow update, delete: if false;
    }

    match /system_settings/{path=**} {
      allow read: if hasCanonicalTenant();
      allow write: if isDeveloper();
    }

    // Final deny-by-default. No implicit authentication-based access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
